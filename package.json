{
  "name": "riftfall-skybreak-web",
  "version": "0.2.0",
  "private": true,
  "description": "Riftfall + Skybreak: browser-native island skirmish, building and target challenges",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "vendor": "node scripts/vendor.mjs",
    "test": "node --test tests/server.test.mjs tests/simulation.test.mjs tests/assets.test.mjs",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:integration": "node tests/integration-smoke.mjs",
    "test:world": "node tests/world-smoke.mjs",
    "check": "node --check dist/world.js && node --check dist/app.js && node --check dist/assets.js"
  },
  "dependencies": {
    "babylonjs": "8.0.0",
    "babylonjs-loaders": "8.0.0"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  },
  "engines": {
    "node": ">=22"
  }
}
